diff --git a/app/limiter/manager.go b/app/limiter/manager.go
new file mode 100644
index 0000000..d4dbabb
--- /dev/null
+++ b/app/limiter/manager.go
@@ -0,0 +1,60 @@
+package limiter
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"sync"
+
+	"github.com/xtls/xray-core/common/buf"
+	"golang.org/x/time/rate"
+)
+
+var userBuckets sync.Map
+
+type userBucket struct {
+	mu      sync.Mutex
+	limit   uint64
+	limiter *rate.Limiter
+}
+
+func NewUserRateLimitWriter(ctx context.Context, writer buf.Writer, email, direction string, bytesPerSecond uint64) buf.Writer {
+	if bytesPerSecond == 0 || email == "" || writer == nil {
+		return writer
+	}
+	bucket := getUserBucket(email, direction, bytesPerSecond)
+	return NewRateLimitWriterWithLimiter(ctx, writer, bucket.limiter)
+}
+
+func getUserBucket(email, direction string, bytesPerSecond uint64) *userBucket {
+	key := fmt.Sprintf("%s\x00%s", email, direction)
+	actual, _ := userBuckets.LoadOrStore(key, &userBucket{
+		limit:   bytesPerSecond,
+		limiter: NewLimiter(bytesPerSecond),
+	})
+	bucket := actual.(*userBucket)
+	bucket.update(bytesPerSecond)
+	return bucket
+}
+
+func (b *userBucket) update(bytesPerSecond uint64) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.limit == bytesPerSecond {
+		return
+	}
+	b.limit = bytesPerSecond
+	b.limiter.SetLimit(rate.Limit(bytesPerSecond))
+	b.limiter.SetBurst(limiterBurst(bytesPerSecond))
+}
+
+func limiterBurst(bytesPerSecond uint64) int {
+	burst := int(bytesPerSecond)
+	if bytesPerSecond > uint64(math.MaxInt) {
+		burst = math.MaxInt
+	}
+	if burst < 1 {
+		burst = 1
+	}
+	return burst
+}
diff --git a/app/limiter/rate.go b/app/limiter/rate.go
new file mode 100644
index 0000000..75babaf
--- /dev/null
+++ b/app/limiter/rate.go
@@ -0,0 +1,70 @@
+package limiter
+
+import (
+	"context"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"golang.org/x/time/rate"
+)
+
+// RateLimitWriter wraps a buf.Writer with a byte-token bucket. The limit is in
+// bytes per second and applies to every WriteMultiBuffer call that passes
+// through this writer.
+type RateLimitWriter struct {
+	writer  buf.Writer
+	limiter *rate.Limiter
+	ctx     context.Context
+}
+
+func NewRateLimitWriter(ctx context.Context, writer buf.Writer, bytesPerSecond uint64) buf.Writer {
+	if bytesPerSecond == 0 || writer == nil {
+		return writer
+	}
+	return NewRateLimitWriterWithLimiter(ctx, writer, NewLimiter(bytesPerSecond))
+}
+
+func NewRateLimitWriterWithLimiter(ctx context.Context, writer buf.Writer, limiter *rate.Limiter) buf.Writer {
+	if limiter == nil || writer == nil {
+		return writer
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return &RateLimitWriter{
+		writer:  writer,
+		limiter: limiter,
+		ctx:     ctx,
+	}
+}
+
+func NewLimiter(bytesPerSecond uint64) *rate.Limiter {
+	return rate.NewLimiter(rate.Limit(bytesPerSecond), limiterBurst(bytesPerSecond))
+}
+
+func (w *RateLimitWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	if mb.IsEmpty() {
+		return w.writer.WriteMultiBuffer(mb)
+	}
+	remaining := int64(mb.Len())
+	for remaining > 0 {
+		n := remaining
+		if n > int64(w.limiter.Burst()) {
+			n = int64(w.limiter.Burst())
+		}
+		if err := w.limiter.WaitN(w.ctx, int(n)); err != nil {
+			buf.ReleaseMulti(mb)
+			return err
+		}
+		remaining -= n
+	}
+	return w.writer.WriteMultiBuffer(mb)
+}
+
+func (w *RateLimitWriter) Close() error {
+	return common.Close(w.writer)
+}
+
+func (w *RateLimitWriter) Interrupt() {
+	common.Interrupt(w.writer)
+}
